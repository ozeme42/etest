<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="10dp">

    <!-- Top Header: Student Name & Book Index -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/widget_student_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="👤 Öğrenci Paneli"
            android:textColor="#ffffff"
            android:textSize="12sp"
            android:textStyle="bold"
            android:singleLine="true" />

        <TextView
            android:id="@+id/widget_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_badge_bg"
            android:text="1/3 Kitap"
            android:textColor="#ffffff"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />
    </LinearLayout>

    <!-- Interactive Book Navigator Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_item_bg"
        android:padding="4dp"
        android:layout_marginBottom="5dp">

        <TextView
            android:id="@+id/widget_btn_prev_book"
            android:layout_width="32dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="◀"
            android:textColor="#a5b4fc"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_book_header_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="📘 4. Sınıf Paragraf Seti"
            android:textColor="#38bdf8"
            android:textSize="12sp"
            android:textStyle="bold"
            android:singleLine="true" />

        <TextView
            android:id="@+id/widget_btn_next_book"
            android:layout_width="32dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="▶"
            android:textColor="#a5b4fc"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Main Book Card Body (Öğrenci Sayfası Detayları) -->
    <LinearLayout
        android:id="@+id/widget_book_card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/widget_item_bg"
        android:padding="8dp">

        <!-- Row 1: Publisher & Success Rate -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/widget_book_publisher"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🏷️ MEB / Özel Yayın"
                android:textColor="#94a3b8"
                android:textSize="10sp"
                android:textStyle="bold"
                android:singleLine="true" />

            <TextView
                android:id="@+id/widget_book_success_rate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎯 %88 Başarı Oranı"
                android:textColor="#fbbf24"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 2: Test Progress Text -->
        <TextView
            android:id="@+id/widget_book_progress_pct"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📊 29 / 40 Test Çözüldü (%72 İlerleme)"
            android:textColor="#34d399"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <!-- Row 3: 4 Stats Badge (Doğru, Yanlış, Boş, Net) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="6dp">

            <!-- Doğru -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#064e3b"
                android:gravity="center"
                android:padding="4dp"
                android:layout_marginEnd="2dp">
                <TextView
                    android:id="@+id/widget_stat_correct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✓ 245 D"
                    android:textColor="#6ee7b7"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Yanlış -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#7f1d1d"
                android:gravity="center"
                android:padding="4dp"
                android:layout_marginEnd="2dp"
                android:layout_marginStart="2dp">
                <TextView
                    android:id="@+id/widget_stat_wrong"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✗ 32 Y"
                    android:textColor="#fca5a5"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Boş -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#334155"
                android:gravity="center"
                android:padding="4dp"
                android:layout_marginEnd="2dp"
                android:layout_marginStart="2dp">
                <TextView
                    android:id="@+id/widget_stat_blank"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="○ 8 B"
                    android:textColor="#cbd5e1"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Net -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#312e81"
                android:gravity="center"
                android:padding="4dp"
                android:layout_marginStart="2dp">
                <TextView
                    android:id="@+id/widget_stat_net"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ 234.3 Net"
                    android:textColor="#c7d2fe"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 4: Subject Breakdown Text -->
        <TextView
            android:id="@+id/widget_book_subjects_breakdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Türkçe: 10/12 • Matematik: 8/10 • Fen: 6/8"
            android:textColor="#cbd5e1"
            android:textSize="9.5sp"
            android:singleLine="true" />

    </LinearLayout>

    <!-- Empty State -->
    <TextView
        android:id="@+id/widget_empty_books"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="Takip edilen kitap bulunmuyor."
        android:textColor="#94a3b8"
        android:textSize="12sp"
        android:gravity="center"
        android:visibility="gone" />

    <!-- Action Button -->
    <LinearLayout
        android:id="@+id/widget_action_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_btn_bg"
        android:gravity="center"
        android:padding="6dp"
        android:layout_marginTop="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📖 Kitap Detayı &amp; Test Haritası ➔"
            android:textColor="#ffffff"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>