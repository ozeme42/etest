<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="10dp">

    <!-- Top Header: App & Student -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/widget_student_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="👤 Öğrenci Paneli"
            android:textColor="#ffffff"
            android:textSize="13sp"
            android:textStyle="bold"
            android:singleLine="true" />

        <TextView
            android:id="@+id/widget_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_badge_bg"
            android:text="1/3 Kitap"
            android:textColor="#ffffff"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />
    </LinearLayout>

    <!-- Interactive Book Navigator Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_item_bg"
        android:padding="4dp"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/widget_btn_prev_book"
            android:layout_width="32dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="◀"
            android:textColor="#a5b4fc"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_book_header_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="📘 4. Sınıf Paragraf Seti"
            android:textColor="#38bdf8"
            android:textSize="12sp"
            android:textStyle="bold"
            android:singleLine="true" />

        <TextView
            android:id="@+id/widget_btn_next_book"
            android:layout_width="32dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="▶"
            android:textColor="#a5b4fc"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Main Student Book Card -->
    <LinearLayout
        android:id="@+id/widget_book_card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/widget_item_bg"
        android:padding="8dp">

        <!-- Publisher & Overall Progress -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/widget_book_publisher"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🏷️ MEB / Özel Yayın"
                android:textColor="#94a3b8"
                android:textSize="10sp"
                android:textStyle="bold"
                android:singleLine="true" />

            <TextView
                android:id="@+id/widget_book_progress_pct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🟢 29/40 Test (%72)"
                android:textColor="#34d399"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Subjects Breakdown (Ders bazlı durum) -->
        <TextView
            android:id="@+id/widget_book_subjects_breakdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Türkçe: 10/12 • Matematik: 8/10 • Fen: 6/8"
            android:textColor="#cbd5e1"
            android:textSize="10sp"
            android:singleLine="true"
            android:layout_marginBottom="6dp" />

        <!-- Next Test Highlight Box -->
        <LinearLayout
            android:id="@+id/widget_next_test_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#0f172a"
            android:padding="6dp"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🎯 SIRADAKİ ÇÖZÜLECEK TEST:"
                    android:textColor="#f59e0b"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_next_test_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1. Ünite - Paragraf Test-4 (Sayfa 21)"
                    android:textColor="#ffffff"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:singleLine="true" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_btn_solve_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_btn_bg"
                android:text="⚡ Çöz"
                android:textColor="#ffffff"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:layout_marginStart="4dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Empty State -->
    <TextView
        android:id="@+id/widget_empty_books"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="Takip edilen kitap bulunmuyor."
        android:textColor="#94a3b8"
        android:textSize="12sp"
        android:gravity="center"
        android:visibility="gone" />

    <!-- Action Button -->
    <LinearLayout
        android:id="@+id/widget_action_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_btn_bg"
        android:gravity="center"
        android:padding="6dp"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/widget_action_btn_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📖 Kitap Detayı &amp; Test Haritası ➔"
            android:textColor="#ffffff"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>