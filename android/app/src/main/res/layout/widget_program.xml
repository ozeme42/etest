<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="10dp">

    <!-- Top Header: App & Student -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/widget_student_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="👤 Öğrenci Paneli"
            android:textColor="#ffffff"
            android:textSize="13sp"
            android:textStyle="bold"
            android:singleLine="true" />

        <TextView
            android:id="@+id/widget_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_badge_bg"
            android:text="0 Görev"
            android:textColor="#ffffff"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />
    </LinearLayout>

    <!-- Interactive Day Navigator Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_item_bg"
        android:padding="4dp"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/widget_btn_prev_day"
            android:layout_width="32dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="◀"
            android:textColor="#a5b4fc"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_day_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="📅 Bugün (Pazartesi)"
            android:textColor="#38bdf8"
            android:textSize="12sp"
            android:textStyle="bold"
            android:singleLine="true" />

        <TextView
            android:id="@+id/widget_btn_next_day"
            android:layout_width="32dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="▶"
            android:textColor="#a5b4fc"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Task Item 1 -->
    <LinearLayout
        android:id="@+id/widget_task_item_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/widget_item_bg"
        android:padding="6dp"
        android:gravity="center_vertical"
        android:layout_marginBottom="3dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_task_status_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏳"
            android:textSize="12sp"
            android:layout_marginEnd="5dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_task_title_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Türkçe - Paragraf Test-1"
                android:textColor="#ffffff"
                android:textSize="11sp"
                android:textStyle="bold"
                android:singleLine="true" />

            <TextView
                android:id="@+id/widget_task_sub_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Türkçe • 1. Ünite"
                android:textColor="#94a3b8"
                android:textSize="9sp"
                android:singleLine="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_task_solve_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_btn_bg"
            android:text="⚡ Çöz"
            android:textColor="#ffffff"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <!-- Task Item 2 -->
    <LinearLayout
        android:id="@+id/widget_task_item_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/widget_item_bg"
        android:padding="6dp"
        android:gravity="center_vertical"
        android:layout_marginBottom="3dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_task_status_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏳"
            android:textSize="12sp"
            android:layout_marginEnd="5dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_task_title_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Matematik - Problem Test-2"
                android:textColor="#ffffff"
                android:textSize="11sp"
                android:textStyle="bold"
                android:singleLine="true" />

            <TextView
                android:id="@+id/widget_task_sub_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Matematik • Sayfa 12"
                android:textColor="#94a3b8"
                android:textSize="9sp"
                android:singleLine="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_task_solve_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_btn_bg"
            android:text="⚡ Çöz"
            android:textColor="#ffffff"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <!-- Task Item 3 -->
    <LinearLayout
        android:id="@+id/widget_task_item_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/widget_item_bg"
        android:padding="6dp"
        android:gravity="center_vertical"
        android:layout_marginBottom="3dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_task_status_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏳"
            android:textSize="12sp"
            android:layout_marginEnd="5dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_task_title_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fen Bilimleri - Test-3"
                android:textColor="#ffffff"
                android:textSize="11sp"
                android:textStyle="bold"
                android:singleLine="true" />

            <TextView
                android:id="@+id/widget_task_sub_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fen Bilimleri"
                android:textColor="#94a3b8"
                android:textSize="9sp"
                android:singleLine="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_task_solve_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_btn_bg"
            android:text="⚡ Çöz"
            android:textColor="#ffffff"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <!-- Task Item 4 -->
    <LinearLayout
        android:id="@+id/widget_task_item_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/widget_item_bg"
        android:padding="6dp"
        android:gravity="center_vertical"
        android:layout_marginBottom="3dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_task_status_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏳"
            android:textSize="12sp"
            android:layout_marginEnd="5dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_task_title_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sosyal Bilgiler - Test-1"
                android:textColor="#ffffff"
                android:textSize="11sp"
                android:textStyle="bold"
                android:singleLine="true" />

            <TextView
                android:id="@+id/widget_task_sub_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sosyal Bilgiler"
                android:textColor="#94a3b8"
                android:textSize="9sp"
                android:singleLine="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_task_solve_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_btn_bg"
            android:text="⚡ Çöz"
            android:textColor="#ffffff"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <!-- Empty State -->
    <TextView
        android:id="@+id/widget_empty_tasks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="🎉 Bu gün için planlanan tüm görevler tamamlandı!"
        android:textColor="#6ee7b7"
        android:textSize="11sp"
        android:textStyle="bold"
        android:gravity="center"
        android:visibility="gone" />

    <!-- Action Button -->
    <LinearLayout
        android:id="@+id/widget_action_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_btn_bg"
        android:gravity="center"
        android:padding="6dp"
        android:layout_marginTop="3dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📅 Tüm Haftalık Programa Git ➔"
            android:textColor="#ffffff"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>